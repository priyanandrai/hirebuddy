datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String   @id @default(uuid())
  email      String?  @unique
  phone      String?  @unique
  name       String?
  image      String?
  role       Role?
  password  String?
  
  // Location fields
  latitude   Float?
  longitude  Float?
  city       String?
  address    String?
  
  // HELPER-specific fields
  slug                    String?   // SEO-friendly helper profile slug (e.g. "ramesh-kumar-electrician-meerut")
  bio                     String?   @db.Text
  isPublicProfileApproved Boolean   @default(false)
  skills      String?   // e.g. "Plumbing, Electrician"
  experience  Int?      // years
  hourlyRate  Int?      // in paise
  isAvailable Boolean   @default(true)
  
  // Ratings & Reviews
  averageRating Float?   @default(0)
  totalReviews  Int      @default(0)
  
  // Wallet
  walletBalance Int      @default(0) // in paise

  // Partner Active Account Subscription (₹4-5/day or monthly pass)
  partnerPlanType         String?   // "DAILY" | "MONTHLY" | "TRIAL"
  subscriptionActiveUntil DateTime?

  // Firebase Cloud Messaging (FCM) Push Notification Token
  fcmToken                String?   @db.VarChar(500)

  // Admin Account Block Controls
  isBlocked               Boolean   @default(false)
  blockedReason           String?   @db.VarChar(500)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // ID verification
  idVerificationStatus IDVerificationStatus @default(UNVERIFIED)
  idDocumentUrl String? @db.VarChar(1000)
  addressProofUrl String? @db.VarChar(1000)
  idDocumentType String?
  addressProofType String?
  idVerifiedAt DateTime?
  idVerificationNotes String?
 
  tasksCreated Task[] @relation("CreatedTasks")
  tasksAssigned Task[] @relation("AssignedTasks")
  messagesFrom Message[] @relation("SenderMessages")
  messagesTo Message[] @relation("ReceiverMessages")
  reviewsGiven Review[] @relation("ReviewsGiven")
  reviewsReceived Review[] @relation("ReviewsReceived")
  paymentsFrom Payment[] @relation("PayerPayments")
  paymentsTo Payment[] @relation("PayeePayments")
  notificationsSent Notification[] @relation("SentNotifications")
  notificationsReceived Notification[] @relation("ReceivedNotifications")
  partnerSubscriptions PartnerSubscription[]
  supportTickets SupportTicket[]
  sellerProfile SellerProfile?
  marketplaceOrders MarketplaceOrder[] @relation("CustomerMarketplaceOrders")
  walletTransactions WalletTransaction[]
  searchLogs SearchLog[]

  // Marketplace Financial, Tax & Payout relations
  helperTaxProfile   HelperTaxProfile?
  helperBankAccounts HelperBankAccount[]
  helperPayouts      HelperPayout[]
  taxWithholdings    TaxWithholding[]
  refundsRequested   Refund[]            @relation("RefundRequester")

  @@index([slug])
}

model Otp {
  id        String   @id @default(uuid())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Task {
  id          String     @id @default(uuid())
  title       String     @db.VarChar(255)
  description String?    @db.Text
  category    String
  location    String     @db.VarChar(500)
  latitude    Float?
  longitude   Float?
  budget      Int      // in paise
  preferredAt DateTime?
  timeSlot    String?
  image       String?  @db.VarChar(1000)
  attachments Json?
  status      TaskStatus @default(OPEN)
  
  // Payment tracking & Immutable Pricing/Tax Snapshot (all monetary values in integer paise)
  paymentStatus PaymentStatus @default(PENDING)
  razorpayOrderId String?
  baseServicePaise            Int?
  discountPaise               Int      @default(0)
  platformFundedDiscountPaise Int      @default(0)
  helperFundedDiscountPaise   Int      @default(0)
  commissionPaise             Int      @default(0)
  gstOnServicePaise           Int      @default(0)
  gstOnCommissionPaise        Int      @default(0)
  tcsPaise                    Int      @default(0)
  tdsPaise                    Int      @default(0)
  totalChargedPaise           Int?
  netHelperPayablePaise       Int?
  supplyType                  String?  @default("ORDINARY_MARKETPLACE") // "ORDINARY_MARKETPLACE" | "SECTION_9_5" | "PRINCIPAL_PROVIDER"
  customerStateCode           String?  @default("UP")
  helperStateCode             String?  @default("UP")
  appliedCommissionRuleId     String?
  appliedTaxRuleId            String?

  createdById  String
  assignedToId String?

  createdBy  User @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  assignedTo User? @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  // Relations
  messages   Message[]
  reviews    Review[]
  payments   Payment[]
  notifications Notification[]
  taxTransactions TaxTransaction[]
  helperPayouts   HelperPayout[]
  refunds         Refund[]
  invoices        Invoice[]

  createdAt DateTime @default(now())
  completedAt DateTime?
}

enum Role {
  USER
  HELPER
  SELLER
  ADMIN
}

enum IDVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum TaskStatus {
  OPEN
  REQUESTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  INITIATED
  CONFIRMED
  HELD_IN_ESCROW
  RELEASED
  SETTLED
  COMPLETED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  DISPUTED
  CHARGEBACK
}

enum MessageType {
  TEXT
  IMAGE
  OFFER
}

// ===== MESSAGE MODEL =====

model Message {
  id        String   @id @default(uuid())
  taskId    String
  senderId  String
  receiverId String
  
  message   String?     @db.Text
  type      MessageType @default(TEXT)
  mediaUrl  String?     @db.VarChar(1000)
  
  isRead    Boolean  @default(false)
  readAt    DateTime?

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sender    User     @relation("SenderMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User     @relation("ReceiverMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  
  @@index([taskId])
  @@index([senderId])
  @@index([receiverId])
}

// ===== REVIEW & RATING MODEL =====
model Review {
  id        String   @id @default(uuid())
  taskId    String
  
  givenById String
  givenToId String
  
  rating    Int      // 1-5 stars
  comment   String?  @db.Text
  
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  givenBy   User     @relation("ReviewsGiven", fields: [givenById], references: [id], onDelete: Cascade)
  givenTo   User     @relation("ReviewsReceived", fields: [givenToId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  
  @@unique([taskId, givenById])
  @@index([givenToId])
}

// ===== PAYMENT MODEL (PROVIDER-AGNOSTIC + RAZORPAY ROUTE) =====
model Payment {
  id        String   @id @default(uuid())
  taskId    String
  
  payerId   String
  payeeId   String
  
  amount    Int      // Total charged to customer in paise
  currency  String   @default("INR")
  
  // Provider & Gateway fields
  provider          String   @default("RAZORPAY") // "RAZORPAY" | "CASHFREE"
  idempotencyKey    String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  gatewayTransferId String?
  transferHoldStatus String? @default("ON_HOLD") // "ON_HOLD" | "RELEASED" | "REVERSED" | "NOT_APPLICABLE"

  // Financial & Tax Snapshot (integer paise)
  baseServicePaise        Int     @default(0)
  discountPaise           Int     @default(0)
  platformDiscountPaise   Int     @default(0)
  helperDiscountPaise     Int     @default(0)
  commissionRateBps       Int     @default(0) // e.g., 1500 = 15.00%
  commissionPaise         Int     @default(0)
  gstOnServicePaise       Int     @default(0)
  gstOnCommissionPaise    Int     @default(0)
  tcsPaise                Int     @default(0)
  tdsPaise                Int     @default(0)
  gatewayFeePaise         Int     @default(0)
  gatewayGstPaise         Int     @default(0)
  netHelperEarningsPaise  Int     @default(0)
  refundedAmountPaise     Int     @default(0)
  supplyType              String  @default("ORDINARY_MARKETPLACE")
  placeOfSupplyState      String  @default("UP")
  isInterState            Boolean @default(false)
  appliedCommissionRuleId String?
  appliedTaxRuleId        String?
  pricingSnapshot         Json?
  
  status    PaymentStatus @default(PENDING)
  method    String   @default("razorpay")
  
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  payer     User     @relation("PayerPayments", fields: [payerId], references: [id], onDelete: Cascade)
  payee     User     @relation("PayeePayments", fields: [payeeId], references: [id], onDelete: Cascade)

  attempts        PaymentAttempt[]
  taxTransactions TaxTransaction[]
  taxWithholdings TaxWithholding[]
  helperPayouts   HelperPayout[]
  refunds         Refund[]
  ledgerJournals  LedgerJournal[]
  invoices        Invoice[]

  createdAt DateTime @default(now())
  completedAt DateTime?
  
  @@index([taskId])
  @@index([payerId])
  @@index([payeeId])
  @@index([razorpayOrderId])
  @@index([razorpayPaymentId])
  @@index([idempotencyKey])
}

// ===== NOTIFICATION MODEL =====
model Notification {
  id        String   @id @default(uuid())
  taskId    String?
  orderId   String?
  
  senderId  String
  receiverId String
  
  type      String   // "task_accepted", "task_completed", "payment_received", "marketplace_order", etc.
  title     String
  message   String?  @db.Text
  
  isRead    Boolean  @default(false)
  readAt    DateTime?

  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sender    User     @relation("SentNotifications", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User     @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  
  @@index([taskId])
  @@index([receiverId])
}

// ===== CATEGORY MODEL (SERVICES + SEO METADATA) =====
model Category {
  id                 String   @id @default(uuid())
  name               String   @unique
  slug               String   @unique
  description        String?  @db.Text
  icon               String?
  subServices        Json?
  isPopular          Boolean  @default(true)
  seoTitle           String?  @db.VarChar(255)
  metaDescription    String?  @db.VarChar(500)
  canonicalUrl       String?  @db.VarChar(500)
  h1Heading          String?  @db.VarChar(255)
  introContent       String?  @db.Text
  detailedContent    String?  @db.Text
  benefits           Json?
  howItWorks         Json?
  faqs               Json?
  startingPricePaise Int      @default(19900)
  ogImage            String?  @db.VarChar(500)
  isActive           Boolean  @default(true)
  isIndexable        Boolean  @default(true)
  publicationStatus  String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ===== PARTNER SUBSCRIPTION MODEL (₹4-5/day or Monthly Pass) =====
model PartnerSubscription {
  id                String   @id @default(uuid())
  userId            String
  planType          String   // "DAILY" | "MONTHLY"
  amountPaise       Int      // e.g. 500 (₹5) or 9900 (₹99)
  daysGranted       Int      @default(1)
  startsAt          DateTime @default(now())
  expiresAt         DateTime
  paymentMethod     String   @default("WALLET") // "WALLET" | "RAZORPAY"
  razorpayOrderId   String?
  razorpayPaymentId String?
  status            String   @default("ACTIVE") // "ACTIVE" | "EXPIRED"
  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ===== CUSTOMER SUPPORT TICKET MODEL =====
model SupportTicket {
  id          String   @id @default(uuid())
  userId      String?
  name        String
  email       String
  phone       String?
  subject     String
  category    String   @default("General")
  message     String   @db.Text
  status      String   @default("OPEN") // "OPEN" | "IN_PROGRESS" | "RESOLVED"
  adminReply  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

// ===== MEERUT MANUFACTURERS MARKETPLACE MODELS =====

model SellerProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String
  businessCategory    String   // Sports Goods, Scissors/Cutlery, Food/Gajak, Brassware, Textiles, Handloom, etc.
  contactPersonName   String
  contactPersonPhone  String
  contactEmail        String?

  // Pickup Point Address
  pickupAddress       String   @db.Text
  pickupCity          String   @default("Meerut")
  pickupPincode       String
  pickupLatitude      Float?
  pickupLongitude     Float?

  // KYC & Regulatory Documents (FSSAI, GSTIN, PAN, MSME/Udyam)
  gstNumber           String?
  gstDocUrl           String?  @db.VarChar(1000)
  fssaiNumber         String?  // Required for Food / Sweets / Consumables
  fssaiDocUrl         String?  @db.VarChar(1000)
  panNumber           String
  panDocUrl           String?  @db.VarChar(1000)
  msmeNumber          String?
  msmeDocUrl          String?  @db.VarChar(1000)
  otherLicenseName    String?
  otherLicenseUrl     String?  @db.VarChar(1000)

  // Bank Account & Daily NEFT / Direct Split Details
  bankAccountHolder   String
  bankAccountNumber   String
  bankIfscCode        String
  bankName            String?
  bankBranch          String?
  cancelledChequeUrl  String?  @db.VarChar(1000)
  razorpayAccountId   String?  // For Razorpay Route direct portion split
  bankVerified        Boolean  @default(false)

  verificationStatus  String   @default("PENDING") // "PENDING" | "VERIFIED" | "REJECTED"
  verificationNotes   String?  @db.Text
  verifiedAt          DateTime?

  products            Product[]
  orders              MarketplaceOrder[]
  settlements         SettlementBatch[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Product {
  id                  String   @id @default(uuid())
  sellerId            String
  seller              SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  name                String
  slug                String   @unique
  description         String   @db.Text
  category            String
  images              Json?    // Array of image URLs
  pricePaise          Int      // Selling price in paise
  mrpPaise            Int?
  stock               Int      @default(50)
  unit                String   @default("piece")
  minOrderQty         Int      @default(1)

  // Admin-configurable commission (10% - 20%) & verification
  commissionRate      Float    @default(15.0)
  status              String   @default("PENDING_APPROVAL") // "DRAFT" | "PENDING_APPROVAL" | "PUBLISHED" | "REJECTED" | "ARCHIVED"
  rejectionReason     String?  @db.Text
  approvedAt          DateTime?
  approvedByAdmin     String?

  // Delivery mode ("SELLER_SELF" | "PLATFORM_HELPER")
  defaultDeliveryMode String   @default("SELLER_SELF")

  orderItems          MarketplaceOrderItem[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([sellerId])
  @@index([status])
  @@index([category])
}

model MarketplaceOrder {
  id                      String   @id @default(uuid())
  orderNumber             String   @unique
  customerId              String
  sellerId                String

  customer                User          @relation("CustomerMarketplaceOrders", fields: [customerId], references: [id], onDelete: Cascade)
  seller                  SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  items                   MarketplaceOrderItem[]

  // Customer Delivery Address
  shippingName            String
  shippingPhone           String
  shippingAddress         String   @db.Text
  shippingCity            String
  shippingPincode         String
  shippingLatitude        Float?
  shippingLongitude       Float?

  // Delivery Mode & 2% Platform Auto-Task
  deliveryMode            String   @default("SELLER_SELF") // "SELLER_SELF" | "PLATFORM_HELPER"
  deliveryFeePaise        Int      @default(0)             // 2% extra charge when PLATFORM_HELPER
  deliveryTaskId          String?  @unique                 // Auto-created Task ID on behalf of Admin

  // Financial Breakdown (Portion-wise split in paise)
  productSubtotalPaise    Int
  platformCommissionRate  Float    @default(15.0)          // e.g. 15%
  platformCommissionPaise Int                              // e.g. 15% of productSubtotalPaise -> Platform Account
  sellerPayablePaise      Int                              // e.g. 85% of productSubtotalPaise -> Seller Account
  totalPaidPaise          Int                              // productSubtotalPaise + deliveryFeePaise

  // Payment & Daily NEFT Settlement Tracking
  paymentStatus           String   @default("PENDING")     // "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  paymentMethod           String   @default("ONLINE")      // "ONLINE" | "RAZORPAY_SPLIT" | "NEFT_ESCROW"
  razorpayOrderId         String?
  razorpayPaymentId       String?
  settlementStatus        String   @default("UNSETTLED")   // "UNSETTLED" | "QUEUED_FOR_NEFT" | "SETTLED_DIRECT_SPLIT" | "SETTLED_NEFT"
  settlementUtr           String?
  settledAt               DateTime?
  settlementBatchId       String?

  orderStatus             String   @default("PLACED")      // "PLACED" | "CONFIRMED" | "PACKED" | "OUT_FOR_DELIVERY" | "DELIVERED" | "CANCELLED"
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([customerId])
  @@index([sellerId])
  @@index([settlementStatus])
}

model MarketplaceOrderItem {
  id                  String           @id @default(uuid())
  orderId             String
  productId           String
  productName         String
  quantity            Int
  unitPricePaise      Int
  commissionRate      Float
  platformSharePaise  Int
  sellerSharePaise    Int

  order               MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model SettlementBatch {
  id                      String        @id @default(uuid())
  sellerId                String
  seller                  SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  settlementDate          DateTime      @default(now())
  totalOrdersCount        Int
  grossAmountPaise        Int
  commissionDeductedPaise Int
  netPayablePaise         Int
  neftUtrNumber           String?
  status                  String        @default("PENDING") // "PENDING" | "PROCESSING" | "PAID" | "FAILED"
  processedByAdmin        String?
  processedAt             DateTime?
  createdAt               DateTime      @default(now())

  @@index([sellerId])
  @@index([status])
}

// ===== WALLET TRANSACTION MODEL =====
model WalletTransaction {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String   // "TOPUP" | "WITHDRAWAL" | "TASK_PAYMENT" | "ESCROW_RELEASE" | "SUBSCRIPTION_PASS" | "REFUND"
  direction         String   @default("CREDIT") // "CREDIT" | "DEBIT"
  amountPaise       Int
  balanceAfterPaise Int      @default(0)
  balanceAfter      Int?     @default(0)
  method            String   @default("ONLINE") // "UPI" | "RAZORPAY" | "BANK_TRANSFER" | "WALLET"
  payoutDestination String?  @db.VarChar(255)
  taskId            String?
  status            String   @default("COMPLETED") // "COMPLETED" | "PENDING" | "FAILED"
  referenceId       String?
  description       String?  @db.VarChar(500)
  metadata          Json?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// ===== USER SEARCH LOG MODEL (Admin Search Analytics) =====
model SearchLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName     String?
  userEmail    String?
  userPhone    String?
  userRole     String?  // "USER" | "HELPER" | "SELLER" | "GUEST"
  query        String   @db.VarChar(500)
  category     String?  @db.VarChar(255)
  location     String?  @db.VarChar(255)
  section      String   @default("HELPERS") // "HELPERS" | "TASKS" | "MARKETPLACE" | "SERVICES"
  resultsCount Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([section])
  @@index([createdAt])
}

// ============================================================================
// PHASE 2: COMPLETE MARKETPLACE PAYMENT, GST, TDS/TCS, PAYOUT & LEDGER MODELS
// ============================================================================

enum TaxConfigStatus {
  DRAFT
  PENDING_CA_REVIEW
  APPROVED
  ACTIVE
  EXPIRED
}

enum SupplyClassification {
  ORDINARY_MARKETPLACE
  SECTION_9_5
  PRINCIPAL_PROVIDER
}

model PaymentProvider {
  id                  String   @id @default(uuid())
  code                String   @unique // "RAZORPAY" | "CASHFREE"
  name                String
  isActive            Boolean  @default(true)
  isDefault           Boolean  @default(false)
  environment         String   @default("SANDBOX") // "SANDBOX" | "PRODUCTION"
  supportsRouteSplit  Boolean  @default(true)
  gatewayFeeBps       Int      @default(200) // e.g. 200 bps = 2.00%
  gstOnGatewayFeeBps  Int      @default(1800) // 18.00% GST on gateway fee
  configMetadata      Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PaymentAttempt {
  id                String   @id @default(uuid())
  paymentId         String
  payment           Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  provider          String   @default("RAZORPAY")
  idempotencyKey    String   @unique
  gatewayOrderId    String?
  gatewayPaymentId  String?
  amountPaise       Int
  currency          String   @default("INR")
  method            String?  // "upi" | "card" | "netbanking" | "wallet"
  status            String   @default("INITIATED") // "INITIATED" | "AUTHORIZED" | "CAPTURED" | "FAILED"
  errorCode         String?
  errorDescription  String?  @db.Text
  rawResponse       Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([paymentId])
  @@index([gatewayOrderId])
}

model PaymentWebhookEvent {
  id               String    @id @default(uuid())
  eventId          String    @unique // Gateway unique webhook event ID for idempotency
  provider         String    @default("RAZORPAY")
  eventType        String    // "payment.captured" | "payment.failed" | "transfer.processed" | "transfer.failed" | "refund.processed" | "payment.dispute.created"
  gatewayOrderId   String?
  gatewayPaymentId String?
  signature        String?   @db.VarChar(500)
  signatureValid   Boolean   @default(false)
  payload          Json
  processingStatus String    @default("RECEIVED") // "RECEIVED" | "PROCESSED" | "DUPLICATE_IGNORED" | "FAILED"
  errorMessage     String?   @db.Text
  processedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([gatewayOrderId])
  @@index([gatewayPaymentId])
  @@index([processingStatus])
}

model CommissionRule {
  id               String    @id @default(uuid())
  name             String
  description      String?   @db.VarChar(500)
  serviceCategory  String?   // null = applies to all categories unless overridden
  helperId         String?   // null = applies to all helpers unless overridden
  commissionModel  String    @default("PERCENTAGE") // "PERCENTAGE" | "FIXED" | "HYBRID" | "ZERO"
  percentageBps    Int       @default(1500) // e.g., 1000 = 10%, 1500 = 15%, 2000 = 20%, 0 = 0%
  fixedAmountPaise Int       @default(0)
  minCommissionPaise Int     @default(0)
  maxCommissionPaise Int?
  isPromotional    Boolean   @default(false)
  promoCode        String?
  priority         Int       @default(10) // Higher priority wins (Helper > Promo > Category > Global)
  isActive         Boolean   @default(true)
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  createdByAdmin   String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([serviceCategory])
  @@index([helperId])
  @@index([isActive])
}

model TaxRule {
  id                       String               @id @default(uuid())
  serviceCategory          String               // e.g. "Home Cleaning", "Plumbing", "Electrician", "Driver", "Carpenter"
  gstClassification        SupplyClassification @default(ORDINARY_MARKETPLACE)
  sacCode                  String?              @db.VarChar(32) // Configurable SAC code reviewed by CA (never hardcoded/invented)
  gstOnServiceRateBps      Int                  @default(1800) // In basis points (e.g. 1800 = 18.00%, 500 = 5.00%, 0 = 0%)
  gstOnCommissionRateBps   Int                  @default(1800) // Platform commission GST rate in bps
  cgstShareBps             Int                  @default(5000) // 50% of GST rate for intra-state
  sgstShareBps             Int                  @default(5000) // 50% of GST rate for intra-state
  igstShareBps             Int                  @default(10000) // 100% of GST rate for inter-state
  isSection95Applicable    Boolean              @default(false)
  isSection52TcsApplicable Boolean              @default(true)
  tcsRateBps               Int                  @default(50)   // Configurable TCS rate in bps (e.g., 50 bps = 0.50% [0.25% CGST + 0.25% SGST or 0.50% IGST])
  taxLiabilityOwner        String               @default("HELPER_IF_REGISTERED") // "PLATFORM_9_5" | "PLATFORM_PRINCIPAL" | "HELPER_IF_REGISTERED" | "EXEMPT"
  invoiceIssuer            String               @default("HELPER_OR_PLATFORM_ON_BEHALF") // "PLATFORM" | "HELPER" | "DUAL_INVOICE"
  requiresHelperGst        Boolean              @default(false)
  tdsSection               String               @default("194-O")
  tdsRateWithPanBps        Int                  @default(10)   // Configurable Sec 194-O rate in bps (e.g. 10 bps = 0.10% or 100 bps = 1.00% as reviewed by CA)
  tdsRateNoPanBps          Int                  @default(500)  // Configurable Sec 206AA higher rate when PAN is missing/invalid (500 bps = 5.00%)
  tdsAnnualThresholdPaise  BigInt               @default(50000000) // e.g. ₹5,00,000 = 50,000,000 paise for Individual/HUF
  effectiveFrom            DateTime             @default(now())
  effectiveTo              DateTime?
  approvalStatus           TaxConfigStatus      @default(PENDING_CA_REVIEW)
  caReviewerName           String?
  caReviewNotes            String?              @db.Text
  approvedAt               DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([serviceCategory])
  @@index([approvalStatus])
}

model HelperTaxProfile {
  id                        String   @id @default(uuid())
  userId                    String   @unique
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalEntityType           String   @default("INDIVIDUAL") // "INDIVIDUAL" | "HUF" | "PROPRIETORSHIP" | "PARTNERSHIP" | "COMPANY"
  panMasked                 String?  @db.VarChar(20) // e.g., "XXXXX1234F"
  panEncrypted              String?  @db.Text
  panHash                   String?
  panVerificationStatus     String   @default("UNVERIFIED") // "UNVERIFIED" | "PENDING" | "VERIFIED" | "INVALID"
  isGstRegistered           Boolean  @default(false)
  gstin                     String?  @db.VarChar(20)
  gstVerificationStatus     String   @default("NOT_APPLICABLE") // "NOT_APPLICABLE" | "VERIFIED" | "INVALID"
  stateCode                 String   @default("UP")
  financialYear             String   @default("2026-27")
  annualGrossTurnoverPaise  BigInt   @default(0) // Cumulative gross service value in current FY
  tdsExemptCertificateNo    String?
  tdsExemptValidUntil       DateTime?
  lowerTdsRateBps           Int?
  payoutSchedulePreference  String   @default("ON_COMPLETION") // "ON_COMPLETION" | "DAILY" | "WEEKLY" | "ADMIN_MANUAL"
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

model HelperBankAccount {
  id                      String   @id @default(uuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  beneficiaryName         String
  accountNumberMasked     String   @db.VarChar(32) // e.g., "XXXXXXXX4321"
  accountNumberEncrypted  String   @db.Text
  ifscCode                String   @db.VarChar(20)
  bankName                String?
  branchName              String?
  upiIdMasked             String?
  razorpayLinkedAccountId String?  // e.g. "acc_..." for Razorpay Route
  razorpayStakeholderId   String?
  razorpayFundAccountId   String?
  verificationStatus      String   @default("PENDING") // "PENDING" | "VERIFIED" | "FAILED"
  isPrimary               Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([userId])
}

model TaxTransaction {
  id                          String   @id @default(uuid())
  taskId                      String
  task                        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  paymentId                   String
  payment                     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  taxRuleId                   String?
  serviceCategory             String
  supplyClassification        String   // "ORDINARY_MARKETPLACE" | "SECTION_9_5" | "PRINCIPAL_PROVIDER"
  sacCode                     String?
  supplierStateCode           String   @default("UP")
  placeOfSupplyStateCode      String   @default("UP")
  isInterState                Boolean  @default(false)
  taxLiabilityOwner           String
  taxableServiceValuePaise    Int      @default(0)
  serviceCgstPaise            Int      @default(0)
  serviceSgstPaise            Int      @default(0)
  serviceIgstPaise            Int      @default(0)
  taxableCommissionValuePaise Int      @default(0)
  commissionCgstPaise         Int      @default(0)
  commissionSgstPaise         Int      @default(0)
  commissionIgstPaise         Int      @default(0)
  isSection52TcsApplicable    Boolean  @default(false)
  tcsNetTaxableBasePaise      Int      @default(0)
  tcsCgstPaise                Int      @default(0)
  tcsSgstPaise                Int      @default(0)
  tcsIgstPaise                Int      @default(0)
  totalTcsPaise               Int      @default(0)
  isReversal                  Boolean  @default(false)
  taxPeriod                   String   // e.g., "2026-11"
  createdAt                   DateTime @default(now())

  @@index([taskId])
  @@index([paymentId])
  @@index([taxPeriod])
}

model TaxWithholding {
  id                      String    @id @default(uuid())
  helperId                String
  helper                  User      @relation(fields: [helperId], references: [id], onDelete: Cascade)
  paymentId               String
  payment                 Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  taskId                  String?
  section                 String    @default("194-O")
  financialYear           String    @default("2026-27")
  quarter                 String    @default("Q3") // "Q1" | "Q2" | "Q3" | "Q4"
  grossTransactionPaise   Int       // Legally applicable gross service amount base
  cumulativeFyGrossPaise  BigInt    @default(0)
  panStatus               String    @default("VERIFIED") // "VERIFIED" | "MISSING_HIGHER_RATE" | "EXEMPT_BELOW_THRESHOLD"
  tdsRateBps              Int       @default(0)
  tdsDeductedPaise        Int       @default(0)
  tdsDepositedPaise       Int       @default(0)
  challanNumber           String?
  bsrCode                 String?
  depositedAt             DateTime?
  certificateNumber       String?   // Form 16A certificate reference
  status                  String    @default("DEDUCTED") // "EXEMPT" | "DEDUCTED" | "DEPOSITED" | "REVERSED"
  createdAt               DateTime  @default(now())

  @@index([helperId])
  @@index([paymentId])
  @@index([financialYear, quarter])
}

model HelperPayout {
  id                      String          @id @default(uuid())
  helperId                String
  helper                  User            @relation(fields: [helperId], references: [id], onDelete: Cascade)
  taskId                  String
  task                    Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  paymentId               String
  payment                 Payment         @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  idempotencyKey          String          @unique
  grossServiceValuePaise  Int
  commissionDeductedPaise Int             @default(0)
  gstOnCommissionPaise    Int             @default(0)
  tcsDeductedPaise        Int             @default(0)
  tdsDeductedPaise        Int             @default(0)
  helperDiscountPaise     Int             @default(0)
  refundAdjustmentPaise   Int             @default(0)
  netPayoutPaise          Int
  payoutSchedule          String          @default("ON_COMPLETION") // "ON_COMPLETION" | "DAILY" | "WEEKLY" | "ADMIN_MANUAL"
  eligibilityStatus       String          @default("PENDING_COMPLETION") // "PENDING_COMPLETION" | "HELD_KYC_INCOMPLETE" | "HELD_BANK_UNVERIFIED" | "HELD_DISPUTE" | "ELIGIBLE" | "APPROVED"
  holdReason              String?         @db.VarChar(500)
  status                  String          @default("PENDING") // "PENDING" | "ON_HOLD" | "PROCESSING" | "SETTLED" | "FAILED" | "REVERSED"
  gatewayProvider         String          @default("RAZORPAY")
  gatewayTransferId       String?
  gatewaySettlementId     String?
  utrNumber               String?
  approvedByAdminId       String?
  approvedAt              DateTime?
  initiatedAt             DateTime?
  settledAt               DateTime?
  attempts                PayoutAttempt[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([helperId])
  @@index([taskId])
  @@index([paymentId])
  @@index([status])
}

model PayoutAttempt {
  id                String       @id @default(uuid())
  payoutId          String
  payout            HelperPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  idempotencyKey    String       @unique
  attemptNumber     Int          @default(1)
  amountPaise       Int
  gatewayTransferId String?
  status            String       @default("INITIATED") // "INITIATED" | "PROCESSED" | "FAILED" | "REVERSED"
  failureReason     String?      @db.Text
  rawResponse       Json?
  createdAt         DateTime     @default(now())

  @@index([payoutId])
}

model Refund {
  id                           String             @id @default(uuid())
  paymentId                    String
  payment                      Payment            @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  taskId                       String
  task                         Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedById                String
  requestedBy                  User               @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approvedByAdminId            String?
  idempotencyKey               String             @unique
  cancellationStage            String             // "BEFORE_ACCEPTANCE" | "AFTER_ACCEPTANCE" | "LATE_CANCELLATION" | "HELPER_NO_SHOW" | "PARTIAL_COMPLETION" | "DISPUTE" | "CHARGEBACK"
  cancelledByRole              String             // "USER" | "HELPER" | "ADMIN"
  refundType                   String             @default("FULL") // "FULL" | "PARTIAL"
  reason                       String             @db.Text
  originalPaidPaise            Int
  refundableCustomerPaise      Int
  cancellationPenaltyPaise     Int                @default(0)
  commissionReversedPaise      Int                @default(0)
  helperEarningsAdjustedPaise  Int                @default(0)
  serviceGstReversedPaise      Int                @default(0)
  commissionGstReversedPaise   Int                @default(0)
  tcsReversedPaise             Int                @default(0)
  tdsReversedPaise             Int                @default(0)
  gatewayFeeNonRefundablePaise Int                @default(0)
  gatewayRefundId              String?
  gatewayTransferReversalId    String?
  wasHelperAlreadyPaid         Boolean            @default(false)
  status                       String             @default("INITIATED") // "INITIATED" | "PROCESSED" | "FAILED"
  processedAt                  DateTime?
  adjustments                  RefundAdjustment[]
  createdAt                    DateTime           @default(now())

  @@index([paymentId])
  @@index([taskId])
}

model RefundAdjustment {
  id                  String   @id @default(uuid())
  refundId            String
  refund              Refund   @relation(fields: [refundId], references: [id], onDelete: Cascade)
  helperId            String
  totalRecoveryPaise  Int      // Amount to recover from helper when refund occurred after payout
  recoveredPaise      Int      @default(0)
  remainingPaise      Int
  status              String   @default("OPEN") // "OPEN" | "PARTIALLY_RECOVERED" | "RECOVERED" | "WAIVED"
  recoveredInPayoutId String?
  notes               String?  @db.VarChar(500)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([helperId])
  @@index([status])
}

model FinancialAccount {
  id           String        @id @default(uuid())
  code         String        @unique // e.g., "1001_CUSTOMER_CLEARING", "2001_HELPER_PAYABLE", "4001_COMMISSION_REVENUE", etc.
  name         String
  accountType  String        // "ASSET" | "LIABILITY" | "REVENUE" | "EXPENSE"
  normalSide   String        // "DEBIT" | "CREDIT"
  balancePaise BigInt        @default(0)
  currency     String        @default("INR")
  entries      LedgerEntry[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model LedgerJournal {
  id                String        @id @default(uuid())
  journalNumber     String        @unique // e.g., "JRN-202611-000001"
  eventType         String        // "PAYMENT_CAPTURED" | "PAYOUT_SETTLED" | "REFUND_ISSUED" | "CHARGEBACK" | "REVERSAL"
  bookingId         String?
  paymentId         String?
  payment           Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  description       String        @db.VarChar(500)
  totalDebitPaise   Int
  totalCreditPaise  Int
  currency          String        @default("INR")
  taxPeriod         String        // e.g., "2026-11"
  isReversal        Boolean       @default(false)
  reversedJournalId String?
  entries           LedgerEntry[]
  createdAt         DateTime      @default(now())

  @@index([bookingId])
  @@index([paymentId])
  @@index([taxPeriod])
}

model LedgerEntry {
  id                   String           @id @default(uuid())
  journalId            String
  journal              LedgerJournal    @relation(fields: [journalId], references: [id], onDelete: Cascade)
  accountId            String
  account              FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  accountCode          String
  bookingId            String?
  paymentId            String?
  helperId             String?
  customerId           String?
  gatewayReference     String?
  debitPaise           Int              @default(0)
  creditPaise          Int              @default(0)
  currency             String           @default("INR")
  taxPeriod            String
  reconciliationStatus String           @default("UNRECONCILED") // "UNRECONCILED" | "MATCHED" | "MISMATCH"
  createdAt            DateTime         @default(now())

  @@index([journalId])
  @@index([accountId])
  @@index([bookingId])
  @@index([paymentId])
  @@index([helperId])
}

model Reconciliation {
  id                 String    @id @default(uuid())
  batchNumber        String    @unique
  reconciliationDate DateTime  @default(now())
  scope              String    @default("FULL") // "PAYMENTS" | "TRANSFERS" | "SETTLEMENTS" | "REFUNDS" | "FULL"
  totalChecked       Int       @default(0)
  matchedCount       Int       @default(0)
  mismatchCount      Int       @default(0)
  discrepancyPaise   Int       @default(0)
  discrepancies      Json?     // Detailed list of mismatched records (orderId, expectedPaise, gatewayPaise, reason)
  status             String    @default("COMPLETED") // "COMPLETED" | "DISCREPANCY_FOUND" | "RESOLVED"
  resolvedByAdmin    String?
  resolvedAt         DateTime?
  createdAt          DateTime  @default(now())
}

model Invoice {
  id                   String   @id @default(uuid())
  invoiceNumber        String   @unique // Sequential within series e.g. "HB/COM/26-27/000001"
  series               String   // "HB/COM" | "HB/SVC" | "HB/95" | "HB/CN" | "HB/DN" | "HB/PAY"
  sequenceNumber       Int
  financialYear        String   @default("2026-27")
  documentType         String   // "COMMISSION_TAX_INVOICE" | "CUSTOMER_SERVICE_INVOICE" | "SECTION_9_5_TAX_INVOICE" | "CREDIT_NOTE" | "DEBIT_NOTE" | "HELPER_PAYOUT_STATEMENT"
  taskId               String
  task                 Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  paymentId            String
  payment              Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  issuerEntity         String   // "HIREBUDDY_PLATFORM" | "HELPER_SUPPLIER"
  issuerName           String
  issuerGstin          String?
  issuerPan            String?
  issuerStateCode      String   @default("UP")
  recipientName        String
  recipientGstin       String?
  recipientStateCode   String   @default("UP")
  placeOfSupply        String   @default("UP")
  sacCode              String?
  taxableValuePaise    Int
  cgstRateBps          Int      @default(0)
  cgstPaise            Int      @default(0)
  sgstRateBps          Int      @default(0)
  sgstPaise            Int      @default(0)
  igstRateBps          Int      @default(0)
  igstPaise            Int      @default(0)
  totalTaxPaise        Int      @default(0)
  totalInvoicePaise    Int
  linkedInvoiceNumber  String?  // Populated for CREDIT_NOTE / DEBIT_NOTE
  lineItems            Json?
  issuedAt             DateTime @default(now())
  createdAt            DateTime @default(now())

  @@unique([series, financialYear, sequenceNumber])
  @@index([taskId])
  @@index([paymentId])
}

model Settlement {
  id                  String    @id @default(uuid())
  gatewaySettlementId String    @unique
  provider            String    @default("RAZORPAY")
  utrNumber           String?
  grossAmountPaise    Int
  gatewayFeePaise     Int       @default(0)
  gatewayGstPaise     Int       @default(0)
  tdsDeductedPaise    Int       @default(0)
  netSettledPaise     Int
  status              String    @default("PROCESSED") // "CREATED" | "PROCESSED" | "FAILED"
  settledAt           DateTime?
  rawPayload          Json?
  createdAt           DateTime  @default(now())
}

model FinancialAuditLog {
  id            String   @id @default(uuid())
  actorId       String
  actorRole     String
  action        String   // "TAX_RULE_CREATED" | "TAX_RULE_CA_APPROVED" | "COMMISSION_RULE_UPDATED" | "PAYOUT_INITIATED" | "REFUND_PROCESSED" | "WEBHOOK_VERIFIED"
  entityType    String
  entityId      String
  previousState Json?
  newState      Json?
  ipAddress     String?
  notes         String?  @db.VarChar(500)
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

// ============================================================================
// TECHNICAL SEO, LOCATIONS, SERVICE-LOCATION LANDING PAGES, CMS, BLOG & AUDITS
// ============================================================================

model ServiceLocation {
  id                  String   @id @default(uuid())
  name                String   @unique
  slug                String   @unique
  stateName           String   @default("Uttar Pradesh")
  stateCode           String   @default("UP")
  latitude            Float?
  longitude           Float?
  serviceAreas        Json?    // Array of supported neighborhoods/sectors
  introContent        String?  @db.Text
  coverageDescription String?  @db.Text
  seoTitle            String?  @db.VarChar(255)
  metaDescription     String?  @db.VarChar(500)
  canonicalUrl        String?  @db.VarChar(500)
  h1Heading           String?  @db.VarChar(255)
  faqs                Json?
  ogImage             String?  @db.VarChar(500)
  activeHelpersCount  Int      @default(0)
  isSupported         Boolean  @default(true)
  isIndexable         Boolean  @default(true)
  publicationStatus   String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([slug])
  @@index([isSupported, isIndexable])
}

model ServiceLocationPage {
  id                    String   @id @default(uuid())
  serviceSlug           String
  locationSlug          String
  serviceName           String
  locationName          String
  seoTitle              String   @db.VarChar(255)
  metaDescription       String   @db.VarChar(500)
  canonicalUrl          String?  @db.VarChar(500)
  h1Heading             String   @db.VarChar(255)
  introContent          String   @db.Text
  localGuideContent     String   @db.Text
  localServiceAreas     Json?
  benefits              Json?
  faqs                  Json?
  startingPricePaise    Int      @default(19900)
  availableHelpersCount Int      @default(0)
  completedJobsCount    Int      @default(0)
  ogImage               String?  @db.VarChar(500)
  isActive              Boolean  @default(true)
  isIndexable           Boolean  @default(true)
  publicationStatus     String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([serviceSlug, locationSlug])
  @@index([serviceSlug])
  @@index([locationSlug])
}

model SeoPageConfig {
  id                String   @id @default(uuid())
  path              String   @unique // e.g., "/", "/about", "/contact", "/pricing", "/safety", "/faq"
  slug              String
  pageType          String   @default("STATIC") // "STATIC" | "SERVICE" | "LOCATION" | "CUSTOM"
  seoTitle          String   @db.VarChar(255)
  metaDescription   String   @db.VarChar(500)
  canonicalUrl      String?  @db.VarChar(500)
  metaRobots        String   @default("index,follow") // "index,follow" | "noindex,nofollow"
  h1Heading         String   @db.VarChar(255)
  introContent      String?  @db.Text
  mainContent       String?  @db.Text
  faqs              Json?
  ogImage           String?  @db.VarChar(500)
  schemaType        String   @default("WebPage") // "WebPage" | "AboutPage" | "ContactPage" | "FAQPage"
  isIndexable       Boolean  @default(true)
  publicationStatus String   @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  redirectToUrl     String?  @db.VarChar(500)
  httpStatusCode    Int      @default(200) // 200 | 301 | 410
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([slug])
  @@index([publicationStatus])
}

model BlogPost {
  id                   String    @id @default(uuid())
  title                String    @db.VarChar(255)
  slug                 String    @unique
  excerpt              String    @db.VarChar(500)
  content              String    @db.LongText
  category             String    @default("Home Services Guide")
  tags                 Json?
  authorName           String    @default("HireBuddy Editorial Team")
  authorRole           String    @default("Home Services & Safety Specialist")
  featuredImage        String?   @db.VarChar(500)
  featuredImageAlt     String?   @db.VarChar(255)
  readingTimeMinutes   Int       @default(5)
  seoTitle             String    @db.VarChar(255)
  metaDescription      String    @db.VarChar(500)
  canonicalUrl         String?   @db.VarChar(500)
  relatedServiceSlugs  Json?
  relatedLocationSlugs Json?
  faqs                 Json?
  isIndexable          Boolean   @default(true)
  publicationStatus    String    @default("PUBLISHED") // "DRAFT" | "PUBLISHED" | "ARCHIVED"
  publishedAt          DateTime? @default(now())
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([category])
  @@index([publicationStatus, isIndexable])
}

model SeoAuditReport {
  id                         String   @id @default(uuid())
  auditScore                 Int      @default(100)
  totalIndexablePages        Int      @default(0)
  totalNoindexPages          Int      @default(0)
  missingMetadataCount       Int      @default(0)
  duplicateTitlesCount       Int      @default(0)
  duplicateDescriptionsCount Int      @default(0)
  missingH1Count             Int      @default(0)
  missingCanonicalCount      Int      @default(0)
  missingAltCount            Int      @default(0)
  thinContentCount           Int      @default(0)
  brokenLinksCount           Int      @default(0)
  invalidSchemaCount         Int      @default(0)
  sitemapStatus              String   @default("VALID")
  structuredDataStatus       String   @default("VALID")
  pageFindings               Json?
  summary                    Json?
  triggeredBy                String   @default("SYSTEM")
  createdAt                  DateTime @default(now())

  @@index([createdAt])
}

